AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/your-runtime-id
AGENTCORE_ENDPOINT_URL=https://your-runtime-endpoint-url.amazonaws.com
USE_AGENTCORE=true
SERPER_API_KEY=
